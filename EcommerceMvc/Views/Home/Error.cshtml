@model EcommerceMvc.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger" role="alert">
    <h1 class="h4">Ocurrió un error inesperado.</h1>
    <p>Intenta nuevamente más tarde o contacta al administrador si el problema continúa.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-0"><strong>Id de solicitud:</strong> <code>@Model.RequestId</code></p>
    }
</div>
