@using System.Text.Json
@model Ecommerce.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Editar usuario";
    var countValidByTipoDocumento = JsonSerializer.Serialize(Model.CountValidByTipoDocumento);
}

<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card dashboard-card">
            <div class="card-body p-4">
                <h2 class="h4 mb-4">Editar usuario</h2>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-document-form>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="UserName" class="form-label"></label>
                            <input asp-for="UserName" class="form-control" autocomplete="username" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MiddleName" class="form-label"></label>
                            <input asp-for="MiddleName" class="form-control" autocomplete="additional-name" />
                            <span asp-validation-for="MiddleName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="SecondLastName" class="form-label"></label>
                            <input asp-for="SecondLastName" class="form-control" />
                            <span asp-validation-for="SecondLastName" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="TipoDocumentoId" class="form-label"></label>
                            <select asp-for="TipoDocumentoId" asp-items="Model.TipoDocumentoOptions" class="form-select" data-document-type>
                                <option value="">Selecciona un tipo de documento</option>
                            </select>
                            <span asp-validation-for="TipoDocumentoId" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="NumDocumento" class="form-label"></label>
                            <input asp-for="NumDocumento" class="form-control" data-document-number />
                            <div class="form-text" data-document-help></div>
                            <span asp-validation-for="NumDocumento" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" class="form-select">
                                <option value="User">Usuario</option>
                                <option value="Admin">Administrador</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const countValidByTipoDocumento = @Html.Raw(countValidByTipoDocumento);
            const form = document.querySelector('[data-document-form]');
            const typeSelect = document.querySelector('[data-document-type]');
            const documentInput = document.querySelector('[data-document-number]');
            const helpText = document.querySelector('[data-document-help]');

            const validateDocumentLength = () => {
                const countValid = countValidByTipoDocumento[typeSelect.value];
                documentInput.removeAttribute('minlength');
                documentInput.removeAttribute('maxlength');
                documentInput.setCustomValidity('');
                helpText.textContent = '';

                if (countValid === null || countValid === undefined) {
                    return true;
                }

                documentInput.minLength = countValid;
                documentInput.maxLength = countValid;
                helpText.textContent = `Debe tener exactamente ${countValid} caracteres.`;

                if (documentInput.value.trim().length !== countValid) {
                    documentInput.setCustomValidity(`El número de documento debe tener exactamente ${countValid} caracteres.`);
                    return false;
                }

                return true;
            };

            typeSelect.addEventListener('change', validateDocumentLength);
            documentInput.addEventListener('input', validateDocumentLength);
            form.addEventListener('submit', (event) => {
                if (!validateDocumentLength()) {
                    event.preventDefault();
                    documentInput.reportValidity();
                }
            });

            validateDocumentLength();
        })();
    </script>
}
