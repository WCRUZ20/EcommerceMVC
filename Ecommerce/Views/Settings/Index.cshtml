@model Ecommerce.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "Configuración";
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="card dashboard-card">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
                    <div>
                        <h2 class="h4 mb-1">Datos del usuario</h2>
                        <p class="text-muted mb-0">Consulta la información de la cuenta con sesión iniciada.</p>
                    </div>
                    <a class="btn btn-primary align-self-md-start" asp-action="ChangePassword">Cambiar contraseña</a>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>

                    <dt class="col-sm-4">Correo</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4">Creado</dt>
                    <dd class="col-sm-8">@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Último acceso</dt>
                    <dd class="col-sm-8">@(Model.LastLoginAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin acceso registrado")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
