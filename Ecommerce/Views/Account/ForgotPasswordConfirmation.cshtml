@{
    ViewData["Title"] = "Solicitud recibida";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-info shadow-sm" role="alert">
            <h1 class="h4">Revisa tu correo</h1>
            <p class="mb-0">
                Si la cuenta existe y está confirmada, recibirás un enlace para restablecer tu contraseña en los próximos minutos.
            </p>
        </div>
        <a asp-action="Login" class="btn btn-primary">Volver al inicio de sesión</a>
    </div>
</div>
