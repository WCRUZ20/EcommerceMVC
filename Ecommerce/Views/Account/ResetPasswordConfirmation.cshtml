@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-success shadow-sm" role="alert">
            <h1 class="h4">Contraseña actualizada</h1>
            <p class="mb-0">Tu contraseña se cambió correctamente. Ya puedes iniciar sesión con tus nuevas credenciales.</p>
        </div>
        <a asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
    </div>
</div>
